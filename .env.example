# Copy this file to .env.local for local server configuration.
# Never commit .env.local. Never use the VITE_ prefix for secrets.
# Values are intentionally blank in this tracked template.

# AI
GROQ_API_KEY=
OPENAI_API_KEY=

# Database
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Storage
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Messaging
EMAIL_PROVIDER_API_KEY=

# Authentication
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Application
KARYA_PUBLIC_APP_URL=

# Set true only for a local developer preview of configured/not-configured state.
KARYA_ENABLE_SECRET_PREVIEW=false
